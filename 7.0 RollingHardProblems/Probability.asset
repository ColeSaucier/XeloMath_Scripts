  m_Name: Probability
  m_EditorClassIdentifier: 
  displayImage: {fileID: 0}
  displayText: 'Cole owns a farm. He is going to randomly kill one for food (He needs
    to eat!).<br>He has 8 pigs, 7 chickens and 10 cows.<br> What is the probability
    of randomly selecting a chicken?<br> P(chicken) = '
  solutionImage: {fileID: 0}
  solutionText: ' P(chicken) = 7 / (8+7+10) = 7/25'
