  m_Name: CostPerGramProtein
  m_EditorClassIdentifier: 
  displayImage: {fileID: 0}
  displayText: A conveinence store sells two brands of protein powder.<br>Brand A
    contains 20 grams of protein and costs $10.20.<br>Brand B contains 12 grams of
    protein and costs $7.08.<br> What is the difference in cost (per gram of protein!)
    between the two brands, and which should you buy?
  solutionImage: {fileID: 0}
  solutionText: $0.08, Brand A is cheaper<br>(10.20/20) = 0.51<br> (7.08/12) = 0.59<br>
    0.59-0.51 = 0.08
